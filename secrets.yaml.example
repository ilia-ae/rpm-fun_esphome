# Copy this file to `secrets.yaml` and fill in your values:
#   cp secrets.yaml.example secrets.yaml
#
# `secrets.yaml` is gitignored — never commit real credentials.

# Wi-Fi credentials for the main network the device will join.
wifi_ssid: "YourWiFiSSID"
wifi_password: "YourWiFiPassword"

# Native API encryption key for Home Assistant.
# 32-byte base64. Generate one with:
#   openssl rand -base64 32
api_ha: "PUT_32_BYTE_BASE64_KEY_HERE="

# Password for ESPHome OTA updates.
# Pick something long and unique — it's the only thing protecting
# remote firmware uploads.
ota_key: "your-strong-ota-password"
